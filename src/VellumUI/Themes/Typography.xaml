<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- ZEN UI TYPOGRAPHY & FONT STYLES                                  -->
    <!-- ================================================================= -->

    <FontFamily x:Key="Zen.Font.Family">Segoe UI, Inter, Aptos, sans-serif</FontFamily>
    <FontFamily x:Key="Zen.Font.Family.Mono">Cascadia Code, Consolas, Fira Code, monospace</FontFamily>
    <FontFamily x:Key="Zen.Font.Family.Monospace">Cascadia Code, Consolas, Fira Code, monospace</FontFamily>

    <!-- Font Sizes (High-density scale) -->
    <sys:Double x:Key="Zen.Font.Size.Micro">10</sys:Double>
    <sys:Double x:Key="Zen.Font.Size.Small">11</sys:Double>
    <sys:Double x:Key="Zen.Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Zen.Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Zen.Font.Size.Subheading">15</sys:Double>
    <sys:Double x:Key="Zen.Font.Size.Heading">18</sys:Double>
    <sys:Double x:Key="Zen.Font.Size.Title">22</sys:Double>
    <sys:Double x:Key="Zen.Font.Size.Display">28</sys:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="Zen.Font.Weight.Regular">Normal</FontWeight>
    <FontWeight x:Key="Zen.Font.Weight.Medium">SemiBold</FontWeight>
    <FontWeight x:Key="Zen.Font.Weight.Bold">Bold</FontWeight>

    <!-- TextBlock Base Style -->
    <Style x:Key="Zen.Style.TextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}" />

    <!-- Text Variants -->
    <Style x:Key="Zen.Style.TextBlock.Body" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}" />

    <Style x:Key="Zen.Style.TextBlock.Secondary" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Secondary}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.Muted" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Muted}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Small}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.VibrantCyan" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.VibrantPurple" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantPurple}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.VibrantGreen" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantGreen}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.VibrantYellow" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantYellow}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.VibrantRose" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantRose}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.VibrantOrange" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantOrange}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.Display" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Display}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Bold}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.Title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Title}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Bold}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.Heading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Heading}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Bold}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.Subheading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Subheading}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Muted}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.Micro" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Micro}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Muted}" />
    </Style>

    <Style x:Key="Zen.Style.TextBlock.Code" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
    </Style>

</ResourceDictionary>
