<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ZenCallout Style -->
    <Style x:Key="Zen.Style.Callout" TargetType="{x:Type controls:ZenCallout}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Primary.Muted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="CornerRadius" Value="{StaticResource Zen.CornerRadius.Default}" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenCallout}">
                    <Border x:Name="calloutBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Severity Icon -->
                            <Path x:Name="severityIcon"
                                  Grid.Column="0"
                                  Data="{StaticResource Zen.Icon.Geometry.Info}"
                                  Fill="{StaticResource Zen.Brush.Primary}"
                                  Stretch="Uniform"
                                  Width="14"
                                  Height="14"
                                  Margin="0,2,10,0"
                                  VerticalAlignment="Top" />

                            <!-- Text Content: Title + Description/Content -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="titleText"
                                           Text="{TemplateBinding Title}"
                                           FontFamily="{StaticResource Zen.Font.Family}"
                                           FontSize="{StaticResource Zen.Font.Size.Body}"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="0,0,0,2" />

                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  TextBlock.FontSize="{StaticResource Zen.Font.Size.Caption}" />
                            </StackPanel>

                            <!-- Optional Action Button -->
                            <ContentControl x:Name="actionHost"
                                            Grid.Column="2"
                                            Content="{TemplateBinding ActionButtonContent}"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />

                            <!-- Optional Dismiss Button -->
                            <Button x:Name="dismissButton"
                                    Grid.Column="3"
                                    Width="18"
                                    Height="18"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="2">
                                            <Path x:Name="closePath"
                                                  Data="{StaticResource Zen.Icon.Geometry.Close}"
                                                  Fill="{StaticResource Zen.Brush.Foreground.Muted}"
                                                  Stretch="Uniform"
                                                  Width="8"
                                                  Height="8"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                                                <Setter TargetName="closePath" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Custom Icon Override -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <!-- Uses default severity icon -->
                        </Trigger>
                        <!-- Action Button Visibility -->
                        <Trigger Property="ActionButtonContent" Value="{x:Null}">
                            <Setter TargetName="actionHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Dismissible -->
                        <Trigger Property="IsDismissible" Value="True">
                            <Setter TargetName="dismissButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Title empty -->
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="titleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Severity: Info -->
                        <Trigger Property="Severity" Value="Info">
                            <Setter TargetName="calloutBorder" Property="Background" Value="{StaticResource Zen.Brush.Primary.Muted}" />
                            <Setter TargetName="calloutBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter TargetName="severityIcon" Property="Data" Value="{StaticResource Zen.Icon.Geometry.Info}" />
                            <Setter TargetName="severityIcon" Property="Fill" Value="{StaticResource Zen.Brush.Primary}" />
                        </Trigger>
                        <!-- Severity: Success -->
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="calloutBorder" Property="Background" Value="{StaticResource Zen.Brush.Success.Muted}" />
                            <Setter TargetName="calloutBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Success}" />
                            <Setter TargetName="severityIcon" Property="Data" Value="{StaticResource Zen.Icon.Geometry.Check}" />
                            <Setter TargetName="severityIcon" Property="Fill" Value="{StaticResource Zen.Brush.Success}" />
                        </Trigger>
                        <!-- Severity: Warning -->
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="calloutBorder" Property="Background" Value="{StaticResource Zen.Brush.Warning.Muted}" />
                            <Setter TargetName="calloutBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Warning}" />
                            <Setter TargetName="severityIcon" Property="Data" Value="{StaticResource Zen.Icon.Geometry.Warning}" />
                            <Setter TargetName="severityIcon" Property="Fill" Value="{StaticResource Zen.Brush.Warning}" />
                        </Trigger>
                        <!-- Severity: Error -->
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="calloutBorder" Property="Background" Value="{StaticResource Zen.Brush.Danger.Muted}" />
                            <Setter TargetName="calloutBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Danger}" />
                            <Setter TargetName="severityIcon" Property="Data" Value="{StaticResource Zen.Icon.Geometry.Close}" />
                            <Setter TargetName="severityIcon" Property="Fill" Value="{StaticResource Zen.Brush.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenCallout}" BasedOn="{StaticResource Zen.Style.Callout}" />

</ResourceDictionary>
