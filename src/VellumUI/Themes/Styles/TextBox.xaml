<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls"
                    xmlns:converters="clr-namespace:VellumUI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Styles/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisConverter" Invert="True" />

    <!-- ================================================================= -->
    <!-- ZEN UI TEXTBOX & PASSWORDBOX STYLES                               -->
    <!-- ================================================================= -->

    <!-- Base TextBox Style -->
    <Style x:Key="Zen.Style.TextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="CaretBrush" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Zen.Brush.Primary.Muted}" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Input}" />
        <Setter Property="Height" Value="{StaticResource Zen.Height.Control.Default}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Padding="{TemplateBinding Padding}"
                                      Margin="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.InputHover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.InputFocus}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource Zen.Style.TextBox}" />

    <!-- PasswordBox Style -->
    <Style x:Key="Zen.Style.PasswordBox" TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="CaretBrush" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Zen.Brush.Primary.Muted}" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Input}" />
        <Setter Property="Height" Value="{StaticResource Zen.Height.Control.Default}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Padding="{TemplateBinding Padding}"
                                      Margin="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.InputHover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.InputFocus}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource Zen.Style.PasswordBox}" />

    <!-- ZenSearchBox Style -->
    <Style x:Key="Zen.Style.SearchBox" TargetType="{x:Type controls:ZenSearchBox}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="CaretBrush" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Zen.Brush.Primary.Muted}" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Height" Value="{StaticResource Zen.Height.Control.Default}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenSearchBox}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            SnapsToDevicePixels="True">
                        <Grid Margin="4,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Icon -->
                            <Path Grid.Column="0"
                                  Data="{StaticResource Zen.Icon.Geometry.Search}"
                                  Fill="{StaticResource Zen.Brush.Foreground.Muted}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="2,0,4,0" />

                            <!-- Placeholder Text -->
                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Placeholder}"
                                       Foreground="{StaticResource Zen.Brush.Foreground.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Content Host -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}"
                                          Margin="0" />

                            <!-- Clear Button -->
                            <Button Grid.Column="2"
                                    Command="{TemplateBinding ClearCommand}"
                                    Style="{StaticResource Zen.Style.Button.Ghost}"
                                    Width="18"
                                    Height="18"
                                    Padding="0"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisConverter}}">
                                <Path Data="{StaticResource Zen.Icon.Geometry.Close}"
                                      Fill="{StaticResource Zen.Brush.Foreground.Muted}"
                                      Width="8"
                                      Height="8"
                                      Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.InputHover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.InputFocus}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Focus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenSearchBox}" BasedOn="{StaticResource Zen.Style.SearchBox}" />

</ResourceDictionary>
