<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- ZEN UI LISTBOX, LISTVIEW & TREEVIEW STYLES                        -->
    <!-- ================================================================= -->

    <!-- ListBoxItem Style -->
    <Style x:Key="Zen.Style.ListBoxItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Dense}" />
        <Setter Property="MinHeight" Value="{StaticResource Zen.Height.Control.Dense}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Primary.Muted}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                            <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource Zen.Style.ListBoxItem}" />

    <!-- ListBox Style -->
    <Style x:Key="Zen.Style.ListBox" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Zen.Style.ListBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource Zen.Style.ListBox}" />

    <!-- ListViewItem Style -->
    <Style x:Key="Zen.Style.ListViewItem" TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource Zen.Style.ListBoxItem}" />
    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource Zen.Style.ListViewItem}" />

    <!-- ListView Style -->
    <Style x:Key="Zen.Style.ListView" TargetType="{x:Type ListView}" BasedOn="{StaticResource Zen.Style.ListBox}" />
    <Style TargetType="{x:Type ListView}" BasedOn="{StaticResource Zen.Style.ListView}" />

</ResourceDictionary>
