<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- ZEN UI STATUS INDICATOR & ICON STYLES                             -->
    <!-- ================================================================= -->

    <!-- ZenIcon Style -->
    <Style x:Key="Zen.Style.Icon" TargetType="{x:Type controls:ZenIcon}">
        <Setter Property="Fill" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="Size" Value="{StaticResource Zen.Icon.Size.Default}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenIcon}">
                    <Path Data="{TemplateBinding Data}"
                          Fill="{TemplateBinding Fill}"
                          Width="{TemplateBinding Size}"
                          Height="{TemplateBinding Size}"
                          Stretch="Uniform"
                          SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenIcon}" BasedOn="{StaticResource Zen.Style.Icon}" />

    <!-- ZenStatusIndicator Style -->
    <Style x:Key="Zen.Style.StatusIndicator" TargetType="{x:Type controls:ZenStatusIndicator}">
        <Setter Property="Size" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenStatusIndicator}">
                    <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                        <!-- Pulsing Glow (Optional) -->
                        <Ellipse x:Name="glow"
                                 Width="{TemplateBinding Size}"
                                 Height="{TemplateBinding Size}"
                                 Fill="{StaticResource Zen.Brush.Success}"
                                 Opacity="0.4"
                                 Visibility="Collapsed" />

                        <!-- Core Indicator Dot -->
                        <Ellipse x:Name="dot"
                                 Width="{TemplateBinding Size}"
                                 Height="{TemplateBinding Size}"
                                 Fill="{StaticResource Zen.Brush.Success}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Status Variants -->
                        <Trigger Property="Status" Value="Online">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Zen.Brush.Success}" />
                            <Setter TargetName="glow" Property="Fill" Value="{StaticResource Zen.Brush.Success}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Offline">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                            <Setter TargetName="glow" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Busy">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Zen.Brush.Danger}" />
                            <Setter TargetName="glow" Property="Fill" Value="{StaticResource Zen.Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Away">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Zen.Brush.Warning}" />
                            <Setter TargetName="glow" Property="Fill" Value="{StaticResource Zen.Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Warning">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Zen.Brush.Warning}" />
                            <Setter TargetName="glow" Property="Fill" Value="{StaticResource Zen.Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Custom">
                            <Setter TargetName="dot" Property="Fill" Value="{Binding CustomBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="glow" Property="Fill" Value="{Binding CustomBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPulsing" Value="True">
                            <Setter TargetName="glow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenStatusIndicator}" BasedOn="{StaticResource Zen.Style.StatusIndicator}" />

</ResourceDictionary>
