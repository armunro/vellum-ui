<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- ZEN UI CHECKBOX & RADIOBUTTON STYLES                             -->
    <!-- ================================================================= -->

    <!-- CheckBox Style -->
    <Style x:Key="Zen.Style.CheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Box -->
                        <Border x:Name="box"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                                VerticalAlignment="Center">
                            <Path x:Name="checkMark"
                                  Data="{StaticResource Zen.Icon.Geometry.Check}"
                                  Fill="{StaticResource Zen.Brush.Primary.Foreground}"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Visibility="Collapsed" />
                        </Border>

                        <!-- Content -->
                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary.Hover}" />
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Zen.Brush.Primary.Muted}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter TargetName="checkMark" Property="Data" Value="{StaticResource Zen.Icon.Geometry.Minus}" />
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource Zen.Style.CheckBox}" />

    <!-- RadioButton Style -->
    <Style x:Key="Zen.Style.RadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Outer Circle / Rounded Border -->
                        <Border x:Name="outer"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                VerticalAlignment="Center">
                            <!-- Inner Dot -->
                            <Ellipse x:Name="dot"
                                     Width="8"
                                     Height="8"
                                     Fill="{StaticResource Zen.Brush.Primary.Foreground}"
                                     Visibility="Collapsed" />
                        </Border>

                        <!-- Content -->
                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="outer" Property="Background" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter TargetName="outer" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary.Hover}" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outer" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="outer" Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
                            <Setter TargetName="outer" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource Zen.Style.RadioButton}" />

</ResourceDictionary>
