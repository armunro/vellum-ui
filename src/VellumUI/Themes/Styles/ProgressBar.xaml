<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- ZEN UI PROGRESSBAR STYLES                                         -->
    <!-- ================================================================= -->

    <!-- Segmented / BarGraph Grid Mask Brush (6px block with 2px gap) -->
    <DrawingBrush x:Key="Zen.Brush.ProgressBar.BarGraphMask"
                  TileMode="Tile"
                  Viewport="0,0,8,12"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,8,12"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,6,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Segmented Background Grid Pattern Brush -->
    <DrawingBrush x:Key="Zen.Brush.ProgressBar.BarGraphTrack"
                  TileMode="Tile"
                  Viewport="0,0,8,12"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,8,12"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Zen.Brush.Background.Input}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,6,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Default / Slim ProgressBar Style -->
    <Style x:Key="Zen.Style.ProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{StaticResource Zen.CornerRadius.Default}" />
                            <Border x:Name="IndeterminateIndicator"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-0.5" Y="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#000EA5E9" Offset="0.0" />
                                        <GradientStop Color="#800EA5E9" Offset="0.3" />
                                        <GradientStop Color="#FF38BDF8" Offset="0.5" />
                                        <GradientStop Color="#800EA5E9" Offset="0.7" />
                                        <GradientStop Color="#000EA5E9" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateIndicator"
                                                         Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.5" To="1.0"
                                                         Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim ProgressBar explicit alias -->
    <Style x:Key="Zen.Style.ProgressBar.Slim" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource Zen.Style.ProgressBar}" />

    <!-- Bar Graph / Segmented Meter ProgressBar Style -->
    <Style x:Key="Zen.Style.ProgressBar.BarGraph" TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="14" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="TemplateRoot">
                            <!-- Background Segment Grid -->
                            <Rectangle x:Name="TrackBackgroundGrid"
                                       Fill="{StaticResource Zen.Brush.ProgressBar.BarGraphTrack}"
                                       Opacity="0.45"
                                       SnapsToDevicePixels="True" />

                            <Border x:Name="PART_Track" />

                            <!-- Active Indicator Masked by Bar Graph Segments -->
                            <Grid x:Name="IndicatorContainer"
                                  HorizontalAlignment="Left"
                                  ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}">
                                    <Border.OpacityMask>
                                        <StaticResource ResourceKey="Zen.Brush.ProgressBar.BarGraphMask" />
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>

                            <!-- Indeterminate Indicator Masked by Bar Graph Segments -->
                            <Border x:Name="IndeterminateIndicator"
                                    HorizontalAlignment="Stretch"
                                    Visibility="Collapsed">
                                <Border.OpacityMask>
                                    <StaticResource ResourceKey="Zen.Brush.ProgressBar.BarGraphMask" />
                                </Border.OpacityMask>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-0.5" Y="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#000EA5E9" Offset="0.0" />
                                        <GradientStop Color="#800EA5E9" Offset="0.3" />
                                        <GradientStop Color="#FF38BDF8" Offset="0.5" />
                                        <GradientStop Color="#800EA5E9" Offset="0.7" />
                                        <GradientStop Color="#000EA5E9" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="IndicatorContainer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BarGraphIndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateIndicator"
                                                         Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.5" To="1.0"
                                                         Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BarGraphIndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Zen.Style.ProgressBar.Segmented" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource Zen.Style.ProgressBar.BarGraph}" />

    <!-- Implicit Styles for ProgressBar -->
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource Zen.Style.ProgressBar}" />

    <!-- ZenProgressBar Style -->
    <Style x:Key="Zen.Style.ZenProgressBar" TargetType="{x:Type controls:ZenProgressBar}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenProgressBar}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="TemplateRoot">
                            <Rectangle x:Name="TrackGrid"
                                       Fill="{StaticResource Zen.Brush.ProgressBar.BarGraphTrack}"
                                       Opacity="0.45"
                                       Visibility="Collapsed"
                                       SnapsToDevicePixels="True" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{StaticResource Zen.CornerRadius.Default}" />
                            <Border x:Name="IndeterminateIndicator"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-0.5" Y="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#000EA5E9" Offset="0.0" />
                                        <GradientStop Color="#800EA5E9" Offset="0.3" />
                                        <GradientStop Color="#FF38BDF8" Offset="0.5" />
                                        <GradientStop Color="#800EA5E9" Offset="0.7" />
                                        <GradientStop Color="#000EA5E9" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ProgressStyle" Value="BarGraph">
                            <Setter Property="Height" Value="14" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
                            <Setter TargetName="TrackGrid" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Indicator" Property="CornerRadius" Value="0" />
                            <Setter TargetName="PART_Indicator" Property="OpacityMask" Value="{StaticResource Zen.Brush.ProgressBar.BarGraphMask}" />
                            <Setter TargetName="IndeterminateIndicator" Property="CornerRadius" Value="0" />
                            <Setter TargetName="IndeterminateIndicator" Property="OpacityMask" Value="{StaticResource Zen.Brush.ProgressBar.BarGraphMask}" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ZenIndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateIndicator"
                                                         Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.5" To="1.0"
                                                         Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ZenIndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenProgressBar}" BasedOn="{StaticResource Zen.Style.ZenProgressBar}" />

</ResourceDictionary>
