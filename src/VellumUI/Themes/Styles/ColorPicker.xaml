<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls"
                    xmlns:converters="clr-namespace:VellumUI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    <converters:ColorToHexConverter x:Key="ColorToHexConverter" />

    <!-- Hue Spectrum Rainbow Brush -->
    <LinearGradientBrush x:Key="Zen.Brush.ColorPicker.HueSpectrum" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFFF0000" Offset="0.0" />
        <GradientStop Color="#FFFFFF00" Offset="0.17" />
        <GradientStop Color="#FF00FF00" Offset="0.33" />
        <GradientStop Color="#FF00FFFF" Offset="0.5" />
        <GradientStop Color="#FF0000FF" Offset="0.67" />
        <GradientStop Color="#FFFF00FF" Offset="0.83" />
        <GradientStop Color="#FFFF0000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Swatch Button Style in ColorPicker -->
    <Style x:Key="Zen.Style.ColorPicker.SwatchButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="outerBorder"
                            Background="Transparent"
                            BorderBrush="{StaticResource Zen.Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="1"
                            SnapsToDevicePixels="True">
                        <Border x:Name="innerBorder"
                                Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                CornerRadius="1"
                                SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Focus}" />
                            <Setter TargetName="outerBorder" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Spectrum Slider Track Template -->
    <ControlTemplate x:Key="Zen.Template.ColorPicker.HueSlider" TargetType="{x:Type Slider}">
        <Grid VerticalAlignment="Center">
            <Border Height="10"
                    Background="{StaticResource Zen.Brush.ColorPicker.HueSpectrum}"
                    BorderBrush="{StaticResource Zen.Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="2"
                    SnapsToDevicePixels="True" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Width="8" Height="14" Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="{StaticResource Zen.Brush.Foreground.Primary}"
                                        BorderBrush="{StaticResource Zen.Brush.Background.Canvas}"
                                        BorderThickness="1"
                                        CornerRadius="1"
                                        SnapsToDevicePixels="True" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- ColorPicker DropDown ToggleButton Template -->
    <ControlTemplate x:Key="Zen.Template.ColorPicker.ToggleButton" TargetType="{x:Type ToggleButton}">
        <Border x:Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Path x:Name="arrow"
                      Grid.Column="1"
                      Data="{StaticResource Zen.Icon.Geometry.ChevronDown}"
                      Fill="{StaticResource Zen.Brush.Foreground.Secondary}"
                      Width="10"
                      Height="10"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.InputHover}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Hover}" />
                <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Focus}" />
                <Setter TargetName="arrow" Property="Data" Value="{StaticResource Zen.Icon.Geometry.ChevronUp}" />
                <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                <Setter TargetName="arrow" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ZenColorPicker Style -->
    <Style x:Key="Zen.Style.ZenColorPicker" TargetType="{x:Type controls:ZenColorPicker}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Zen.CornerRadius.Default}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Height" Value="{StaticResource Zen.Height.Control.Default}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenColorPicker}">
                    <Grid>
                        <!-- ============================================= -->
                        <!-- DROPDOWN MODE TRIGGER BUTTON                  -->
                        <!-- ============================================= -->
                        <Grid x:Name="DropDownTriggerContainer">
                            <ToggleButton x:Name="DropDownTrigger"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="True"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource Zen.Template.ColorPicker.ToggleButton}"
                                          Cursor="Hand"
                                          SnapsToDevicePixels="True" />

                            <Grid Margin="{TemplateBinding Padding}"
                                  IsHitTestVisible="False"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>

                                <!-- Color Swatch Square -->
                                <Border Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        Background="{Binding SelectedBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                        BorderBrush="{StaticResource Zen.Brush.Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True" />

                                <!-- Hex Code Text -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding HexCode, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{StaticResource Zen.Font.Family.Mono}"
                                           FontSize="{StaticResource Zen.Font.Size.Body}"
                                           VerticalAlignment="Center"
                                           SnapsToDevicePixels="True" />
                            </Grid>
                        </Grid>

                        <!-- ============================================= -->
                        <!-- DROPDOWN POPUP                                -->
                        <!-- ============================================= -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=DropDownTriggerContainer}"
                               StaysOpen="False"
                               PopupAnimation="Slide"
                               Focusable="False">
                            <Border x:Name="PopupContainer"
                                    Width="260"
                                    Background="{StaticResource Zen.Brush.Background.Popup}"
                                    BorderBrush="{StaticResource Zen.Brush.Border.Default}"
                                    BorderThickness="{StaticResource Zen.Thickness.Border}"
                                    CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                                    Padding="10"
                                    Margin="0,2,0,4"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <!-- Header / Preview Bar -->
                                    <Grid Margin="0,0,0,8" Visibility="{Binding ShowPreview, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Preview Box -->
                                        <Border Grid.Column="0"
                                                Height="28"
                                                Background="{Binding SelectedBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                                BorderBrush="{StaticResource Zen.Brush.Border.Default}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                SnapsToDevicePixels="True" />

                                        <!-- Hex Code Box -->
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding HexCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}"
                                                 FontFamily="{StaticResource Zen.Font.Family.Mono}"
                                                 FontSize="{StaticResource Zen.Font.Size.Body}"
                                                 Margin="6,0,0,0"
                                                 Height="28"
                                                 VerticalContentAlignment="Center"
                                                 Padding="6,0"
                                                 Visibility="{Binding ShowHex, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}" />
                                    </Grid>

                                    <!-- Hue Slider -->
                                    <StackPanel Visibility="{Binding ShowSliders, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,6">
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Hue" Style="{StaticResource Zen.Style.TextBlock.Caption}" FontSize="{StaticResource Zen.Font.Size.Micro}" />
                                            <TextBlock Text="{Binding Hue, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:F0}°'}"
                                                       Style="{StaticResource Zen.Style.TextBlock.Secondary}"
                                                       FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="360"
                                                Value="{Binding Hue, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                Template="{StaticResource Zen.Template.ColorPicker.HueSlider}"
                                                Margin="0,0,0,6" />

                                        <!-- Saturation Slider -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Saturation" Style="{StaticResource Zen.Style.TextBlock.Caption}" FontSize="{StaticResource Zen.Font.Size.Micro}" />
                                            <TextBlock Text="{Binding Saturation, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:F0}%'}"
                                                       Style="{StaticResource Zen.Style.TextBlock.Secondary}"
                                                       FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="100"
                                                Value="{Binding Saturation, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                Height="16"
                                                Margin="0,0,0,6" />

                                        <!-- Brightness Slider -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Brightness" Style="{StaticResource Zen.Style.TextBlock.Caption}" FontSize="{StaticResource Zen.Font.Size.Micro}" />
                                            <TextBlock Text="{Binding Brightness, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:F0}%'}"
                                                       Style="{StaticResource Zen.Style.TextBlock.Secondary}"
                                                       FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="100"
                                                Value="{Binding Brightness, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                Height="16"
                                                Margin="0,0,0,6" />

                                        <!-- Alpha Slider -->
                                        <Grid Margin="0,0,0,2" Visibility="{Binding ShowAlpha, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Opacity / Alpha" Style="{StaticResource Zen.Style.TextBlock.Caption}" FontSize="{StaticResource Zen.Font.Size.Micro}" />
                                            <TextBlock Text="{Binding A, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Style="{StaticResource Zen.Style.TextBlock.Secondary}"
                                                       FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="255"
                                                Value="{Binding A, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                Height="16"
                                                Margin="0,0,0,6"
                                                Visibility="{Binding ShowAlpha, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}" />
                                    </StackPanel>

                                    <!-- Palette Swatches Section -->
                                    <StackPanel Visibility="{Binding ShowPalette, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Palette Swatches"
                                                   Style="{StaticResource Zen.Style.TextBlock.Caption}"
                                                   FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                   Margin="0,2,0,4" />
                                        <ItemsControl ItemsSource="{Binding PaletteColors, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Zen.Style.ColorPicker.SwatchButton}"
                                                            Command="{Binding SelectColorCommand, RelativeSource={RelativeSource AncestorType=controls:ZenColorPicker}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding Converter={StaticResource ColorToHexConverter}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- ============================================= -->
                        <!-- INLINE MODE CONTAINER                         -->
                        <!-- ============================================= -->
                        <Border x:Name="InlineContainer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                                Padding="10"
                                Visibility="Collapsed"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <!-- Header / Preview Bar -->
                                <Grid Margin="0,0,0,8" Visibility="{Binding ShowPreview, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Preview Box -->
                                    <Border Grid.Column="0"
                                            Height="28"
                                            Background="{Binding SelectedBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                            BorderBrush="{StaticResource Zen.Brush.Border.Default}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            SnapsToDevicePixels="True" />

                                    <!-- Hex Code Box -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding HexCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}"
                                             FontFamily="{StaticResource Zen.Font.Family.Mono}"
                                             FontSize="{StaticResource Zen.Font.Size.Body}"
                                             Margin="6,0,0,0"
                                             Height="28"
                                             VerticalContentAlignment="Center"
                                             Padding="6,0"
                                             Visibility="{Binding ShowHex, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>

                                <!-- Hue Slider -->
                                <StackPanel Visibility="{Binding ShowSliders, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,6">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Hue" Style="{StaticResource Zen.Style.TextBlock.Caption}" FontSize="{StaticResource Zen.Font.Size.Micro}" />
                                        <TextBlock Text="{Binding Hue, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:F0}°'}"
                                                   Style="{StaticResource Zen.Style.TextBlock.Secondary}"
                                                   FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider Minimum="0"
                                            Maximum="360"
                                            Value="{Binding Hue, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Template="{StaticResource Zen.Template.ColorPicker.HueSlider}"
                                            Margin="0,0,0,6" />

                                    <!-- Saturation Slider -->
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Saturation" Style="{StaticResource Zen.Style.TextBlock.Caption}" FontSize="{StaticResource Zen.Font.Size.Micro}" />
                                        <TextBlock Text="{Binding Saturation, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:F0}%'}"
                                                   Style="{StaticResource Zen.Style.TextBlock.Secondary}"
                                                   FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider Minimum="0"
                                            Maximum="100"
                                            Value="{Binding Saturation, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Height="16"
                                            Margin="0,0,0,6" />

                                    <!-- Brightness Slider -->
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Brightness" Style="{StaticResource Zen.Style.TextBlock.Caption}" FontSize="{StaticResource Zen.Font.Size.Micro}" />
                                        <TextBlock Text="{Binding Brightness, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:F0}%'}"
                                                   Style="{StaticResource Zen.Style.TextBlock.Secondary}"
                                                   FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider Minimum="0"
                                            Maximum="100"
                                            Value="{Binding Brightness, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Height="16"
                                            Margin="0,0,0,6" />

                                    <!-- Alpha Slider -->
                                    <Grid Margin="0,0,0,2" Visibility="{Binding ShowAlpha, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Opacity / Alpha" Style="{StaticResource Zen.Style.TextBlock.Caption}" FontSize="{StaticResource Zen.Font.Size.Micro}" />
                                        <TextBlock Text="{Binding A, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Style="{StaticResource Zen.Style.TextBlock.Secondary}"
                                                   FontSize="{StaticResource Zen.Font.Size.Micro}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider Minimum="0"
                                            Maximum="255"
                                            Value="{Binding A, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Height="16"
                                            Margin="0,0,0,6"
                                            Visibility="{Binding ShowAlpha, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>

                                <!-- Palette Swatches Section -->
                                <StackPanel Visibility="{Binding ShowPalette, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="Palette Swatches"
                                               Style="{StaticResource Zen.Style.TextBlock.Caption}"
                                               FontSize="{StaticResource Zen.Font.Size.Micro}"
                                               Margin="0,2,0,4" />
                                    <ItemsControl ItemsSource="{Binding PaletteColors, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Zen.Style.ColorPicker.SwatchButton}"
                                                        Command="{Binding SelectColorCommand, RelativeSource={RelativeSource AncestorType=controls:ZenColorPicker}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding Converter={StaticResource ColorToHexConverter}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============================================= -->
                        <!-- PALETTE-ONLY MODE CONTAINER                   -->
                        <!-- ============================================= -->
                        <Border x:Name="PaletteOnlyContainer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                                Padding="4"
                                Visibility="Collapsed"
                                SnapsToDevicePixels="True">
                            <ItemsControl ItemsSource="{Binding PaletteColors, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Zen.Style.ColorPicker.SwatchButton}"
                                                Command="{Binding SelectColorCommand, RelativeSource={RelativeSource AncestorType=controls:ZenColorPicker}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Converter={StaticResource ColorToHexConverter}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Inline Mode Trigger -->
                        <Trigger Property="DisplayMode" Value="Inline">
                            <Setter TargetName="DropDownTriggerContainer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InlineContainer" Property="Visibility" Value="Visible" />
                            <Setter Property="Height" Value="Auto" />
                        </Trigger>
                        <!-- PaletteOnly Mode Trigger -->
                        <Trigger Property="DisplayMode" Value="PaletteOnly">
                            <Setter TargetName="DropDownTriggerContainer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PaletteOnlyContainer" Property="Visibility" Value="Visible" />
                            <Setter Property="Height" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenColorPicker}" BasedOn="{StaticResource Zen.Style.ZenColorPicker}" />

</ResourceDictionary>
