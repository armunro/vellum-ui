<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- ZEN UI BUTTON STYLES                                              -->
    <!-- ================================================================= -->

    <!-- Primary Button (Vibrant Cyan / Sky) -->
    <Style x:Key="Zen.Style.Button.Primary" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Primary.Foreground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary.Hover}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Button}" />
        <Setter Property="Height" Value="{StaticResource Zen.Height.Control.Default}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Primary.Hover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Primary.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

