<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Close Button Style for ZenTag -->
    <Style x:Key="Zen.Style.Tag.CloseButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="Transparent"
                            CornerRadius="2">
                        <Path x:Name="path"
                              Data="{StaticResource Zen.Icon.Geometry.Close}"
                              Fill="{StaticResource Zen.Brush.Foreground.Muted}"
                              Stretch="Uniform"
                              Width="8"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                            <Setter TargetName="path" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfacePressed}" />
                            <Setter TargetName="path" Property="Fill" Value="{StaticResource Zen.Brush.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default ZenTag Style -->
    <Style x:Key="Zen.Style.Tag" TargetType="{x:Type controls:ZenTag}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="6,1,6,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CornerRadius" Value="{StaticResource Zen.CornerRadius.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenTag}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Optional Left Icon -->
                            <Path x:Name="iconPath"
                                  Data="{TemplateBinding Icon}"
                                  Fill="{TemplateBinding Foreground}"
                                  Stretch="Uniform"
                                  Width="10"
                                  Height="10"
                                  Margin="0,0,4,0"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center" />

                            <!-- Tag Content -->
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True" />

                            <!-- Optional Close / Delete Button -->
                            <Button x:Name="closeButton"
                                    Style="{StaticResource Zen.Style.Tag.CloseButton}"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Show Icon if present -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="iconPath" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsRemovable" Value="True">
                            <Setter TargetName="closeButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelectable" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                        <!-- Hover (Selectable) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelectable" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
                        </MultiTrigger>
                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Primary.Muted}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                            <Setter TargetName="iconPath" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenTag}" BasedOn="{StaticResource Zen.Style.Tag}" />

</ResourceDictionary>
