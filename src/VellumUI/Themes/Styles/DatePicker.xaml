<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:controls="clr-namespace:VellumUI.Controls"
                    xmlns:converters="clr-namespace:VellumUI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />

    <!-- ================================================================= -->
    <!-- ZEN UI CALENDAR & DATEPICKER STYLES                               -->
    <!-- ================================================================= -->

    <!-- Calendar Navigation Header Buttons -->
    <Style x:Key="Zen.Style.Calendar.NavButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Zen.Style.Calendar.HeaderButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfacePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar Day Button (1..31) -->
    <Style x:Key="Zen.Style.CalendarDayButton" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Caption}" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Border x:Name="DayButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Margin="1"
                            Padding="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="NormalText"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DayButtonBorder" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="DayButtonBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter TargetName="DayButtonBorder" Property="Background" Value="{StaticResource Zen.Brush.Primary.Muted}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DayButtonBorder" Property="Background" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter TargetName="DayButtonBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Primary.Foreground}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                            <Setter Property="Opacity" Value="0.2" />
                            <Setter Property="IsEnabled" Value="False" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CalendarDayButton}" BasedOn="{StaticResource Zen.Style.CalendarDayButton}" />

    <!-- Calendar Month/Year Button -->
    <Style x:Key="Zen.Style.CalendarButton" TargetType="{x:Type CalendarButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Caption}" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Border x:Name="CalendarButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Margin="2"
                            Padding="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="NormalText"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CalendarButtonBorder" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="CalendarButtonBorder" Property="Background" Value="{StaticResource Zen.Brush.Primary}" />
                            <Setter TargetName="CalendarButtonBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Primary.Foreground}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CalendarButton}" BasedOn="{StaticResource Zen.Style.CalendarButton}" />

    <!-- CalendarItem Style -->
    <Style x:Key="Zen.Style.CalendarItem" TargetType="{x:Type CalendarItem}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Popup}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="DayTitleTemplate">
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource Zen.Brush.Foreground.Muted}"
                                       FontFamily="{StaticResource Zen.Font.Family}"
                                       FontSize="{StaticResource Zen.Font.Size.Micro}"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,2,0,4" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            Padding="8"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Navigation Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_PreviousButton"
                                        Grid.Column="0"
                                        Style="{StaticResource Zen.Style.Calendar.NavButton}">
                                    <Path Data="{StaticResource Zen.Icon.Geometry.ChevronLeft}"
                                          Fill="{StaticResource Zen.Brush.Foreground.Secondary}"
                                          Width="8"
                                          Height="8"
                                          Stretch="Uniform" />
                                </Button>

                                <Button x:Name="PART_HeaderButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource Zen.Style.Calendar.HeaderButton}" />

                                <Button x:Name="PART_NextButton"
                                        Grid.Column="2"
                                        Style="{StaticResource Zen.Style.Calendar.NavButton}">
                                    <Path Data="{StaticResource Zen.Icon.Geometry.ChevronRight}"
                                          Fill="{StaticResource Zen.Brush.Foreground.Secondary}"
                                          Width="8"
                                          Height="8"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Month & Year Views -->
                            <Grid Grid.Row="1">
                                <!-- Month View Grid -->
                                <Grid x:Name="PART_MonthView" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>

                                <!-- Year View Grid -->
                                <Grid x:Name="PART_YearView" Visibility="Hidden">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CalendarItem}" BasedOn="{StaticResource Zen.Style.CalendarItem}" />

    <!-- Calendar Style -->
    <Style x:Key="Zen.Style.Calendar" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Popup}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource Zen.Style.CalendarItem}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Zen.Style.CalendarDayButton}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource Zen.Style.CalendarButton}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Style="{TemplateBinding CalendarItemStyle}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Calendar}" BasedOn="{StaticResource Zen.Style.Calendar}" />

    <!-- DatePicker TextBox Style -->
    <Style x:Key="Zen.Style.DatePickerTextBox" TargetType="{x:Type primitives:DatePickerTextBox}">
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Input}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <ContentControl x:Name="PART_Watermark"
                                        Focusable="False"
                                        IsHitTestVisible="False"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <TextBlock Text="Select date..." Foreground="{StaticResource Zen.Brush.Foreground.Muted}" />
                        </ContentControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:DatePickerTextBox}" BasedOn="{StaticResource Zen.Style.DatePickerTextBox}" />

    <!-- DatePicker Toggle/Calendar Button -->
    <Style x:Key="Zen.Style.DatePicker.CalendarButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0,2,2,0"
                            SnapsToDevicePixels="True">
                        <Path x:Name="icon"
                              Data="{StaticResource Zen.Icon.Geometry.Calendar}"
                              Fill="{StaticResource Zen.Brush.Foreground.Secondary}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.InputHover}" />
                            <Setter TargetName="icon" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Zen.Brush.Background.SurfacePressed}" />
                            <Setter TargetName="icon" Property="Fill" Value="{StaticResource Zen.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="icon" Property="Fill" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard DatePicker Style -->
    <Style x:Key="Zen.Style.DatePicker" TargetType="{x:Type DatePicker}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Input}" />
        <Setter Property="Height" Value="{StaticResource Zen.Height.Control.Default}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CalendarStyle" Value="{StaticResource Zen.Style.Calendar}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                          Grid.Column="0"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Padding="{TemplateBinding Padding}"
                                                          FontFamily="{TemplateBinding FontFamily}"
                                                          FontSize="{TemplateBinding FontSize}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Focusable="{TemplateBinding Focusable}" />

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Style="{StaticResource Zen.Style.DatePicker.CalendarButton}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=MainBorder}"
                                   StaysOpen="False">
                                <Border Background="{StaticResource Zen.Brush.Background.Popup}"
                                        BorderBrush="{StaticResource Zen.Brush.Border.Default}"
                                        BorderThickness="{StaticResource Zen.Thickness.Border}"
                                        CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                                        Margin="0,2,0,4"
                                        SnapsToDevicePixels="True">
                                    <Calendar x:Name="PART_Calendar"
                                              Style="{TemplateBinding CalendarStyle}"
                                              DisplayDate="{TemplateBinding DisplayDate}"
                                              DisplayDateStart="{TemplateBinding DisplayDateStart}"
                                              DisplayDateEnd="{TemplateBinding DisplayDateEnd}"
                                              FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                              IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                                              SelectedDate="{TemplateBinding SelectedDate}" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Zen.Brush.Background.InputHover}" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource Zen.Style.DatePicker}" />

    <!-- ZenDatePicker Style -->
    <Style x:Key="Zen.Style.ZenDatePicker" TargetType="{x:Type controls:ZenDatePicker}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Zen.CornerRadius.Default}" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Input}" />
        <Setter Property="Height" Value="{StaticResource Zen.Height.Control.Default}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CalendarStyle" Value="{StaticResource Zen.Style.Calendar}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenDatePicker}">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Optional Custom Left Icon -->
                            <Path x:Name="customIcon"
                                  Grid.Column="0"
                                  Data="{TemplateBinding Icon}"
                                  Fill="{StaticResource Zen.Brush.Foreground.Muted}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />

                            <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                          Grid.Column="1"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Padding="{TemplateBinding Padding}"
                                                          FontFamily="{TemplateBinding FontFamily}"
                                                          FontSize="{TemplateBinding FontSize}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Focusable="{TemplateBinding Focusable}" />

                            <Button x:Name="PART_Button"
                                    Grid.Column="2"
                                    Style="{StaticResource Zen.Style.DatePicker.CalendarButton}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=MainBorder}"
                                   StaysOpen="False">
                                <Border Background="{StaticResource Zen.Brush.Background.Popup}"
                                        BorderBrush="{StaticResource Zen.Brush.Border.Default}"
                                        BorderThickness="{StaticResource Zen.Thickness.Border}"
                                        CornerRadius="{StaticResource Zen.CornerRadius.Default}"
                                        Margin="0,2,0,4"
                                        SnapsToDevicePixels="True">
                                    <Calendar x:Name="PART_Calendar"
                                              Style="{TemplateBinding CalendarStyle}"
                                              DisplayDate="{TemplateBinding DisplayDate}"
                                              DisplayDateStart="{TemplateBinding DisplayDateStart}"
                                              DisplayDateEnd="{TemplateBinding DisplayDateEnd}"
                                              FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                              IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                                              SelectedDate="{TemplateBinding SelectedDate}" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="customIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisConverter}}" Value="Visible">
                            <Setter TargetName="customIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Zen.Brush.Background.InputHover}" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Zen.Brush.Background.Canvas}" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenDatePicker}" BasedOn="{StaticResource Zen.Style.ZenDatePicker}" />

</ResourceDictionary>
