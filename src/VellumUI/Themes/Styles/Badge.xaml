<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- ZEN UI BADGE STYLES                                               -->
    <!-- ================================================================= -->

    <Style x:Key="Zen.Style.Badge" TargetType="{x:Type controls:ZenBadge}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Primary.Muted}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Zen.CornerRadius.Default}" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Micro}" />
        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenBadge}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            TextBlock.Foreground="{TemplateBinding Foreground}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Secondary -->
            <Trigger Property="Variant" Value="Secondary">
                <Setter Property="Background" Value="{StaticResource Zen.Brush.Secondary.Muted}" />
                <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Secondary}" />
                <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantPurple}" />
            </Trigger>
            <!-- Success -->
            <Trigger Property="Variant" Value="Success">
                <Setter Property="Background" Value="{StaticResource Zen.Brush.Success.Muted}" />
                <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Success}" />
                <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantGreen}" />
            </Trigger>
            <!-- Warning -->
            <Trigger Property="Variant" Value="Warning">
                <Setter Property="Background" Value="{StaticResource Zen.Brush.Warning.Muted}" />
                <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Warning}" />
                <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantYellow}" />
            </Trigger>
            <!-- Danger -->
            <Trigger Property="Variant" Value="Danger">
                <Setter Property="Background" Value="{StaticResource Zen.Brush.Danger.Muted}" />
                <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Danger}" />
                <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantRose}" />
            </Trigger>
            <!-- Info -->
            <Trigger Property="Variant" Value="Info">
                <Setter Property="Background" Value="{StaticResource Zen.Brush.Info.Muted}" />
                <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Info}" />
                <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
            </Trigger>
            <!-- Muted -->
            <Trigger Property="Variant" Value="Muted">
                <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Secondary}" />
            </Trigger>
            <!-- Outline -->
            <Trigger Property="Variant" Value="Outline">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
                <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:ZenBadge}" BasedOn="{StaticResource Zen.Style.Badge}" />

</ResourceDictionary>
