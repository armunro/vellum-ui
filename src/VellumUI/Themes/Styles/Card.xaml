<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls"
                    xmlns:converters="clr-namespace:VellumUI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VellumUI;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />

    <!-- ================================================================= -->
    <!-- ZEN UI CARD & CONTAINER STYLES                                    -->
    <!-- ================================================================= -->

    <!-- ZenCard Style -->
    <Style x:Key="Zen.Style.Card" TargetType="{x:Type controls:ZenCard}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="CornerRadius" Value="{StaticResource Zen.CornerRadius.Default}" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Card}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZenCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Accent Line (Optional) -->
                            <Border x:Name="topAccent"
                                    Grid.Row="0"
                                    Height="2"
                                    Background="{TemplateBinding HighlightBrush}"
                                    CornerRadius="2,2,0,0"
                                    Visibility="{TemplateBinding ShowTopAccent, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Header Bar (if Header or Subtitle or HeaderAction is set) -->
                            <Border x:Name="headerArea"
                                    Grid.Row="1"
                                    BorderBrush="{StaticResource Zen.Brush.Border.Subtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,6"
                                    Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title & Subtitle -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <ContentPresenter ContentSource="Header"
                                                          RecognizesAccessKey="True">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
                                                    <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
                                                    <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Subheading}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                        <TextBlock Text="{TemplateBinding Subtitle}"
                                                   Style="{StaticResource Zen.Style.TextBlock.Muted}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisConverter}}" />
                                    </StackPanel>

                                    <!-- Action Content (e.g. Buttons, Badges) -->
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding HeaderAction}"
                                                      VerticalAlignment="Center"
                                                      Margin="4,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- Main Body Content -->
                            <Border Grid.Row="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ZenCard}" BasedOn="{StaticResource Zen.Style.Card}" />

    <!-- GroupBox Style -->
    <Style x:Key="Zen.Style.GroupBox" TargetType="{x:Type GroupBox}">
        <Setter Property="Background" Value="{StaticResource Zen.Brush.Background.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Zen.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Zen.Thickness.Border}" />
        <Setter Property="Padding" Value="{StaticResource Zen.Padding.Card}" />
        <Setter Property="FontFamily" Value="{StaticResource Zen.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Zen.Font.Size.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource Zen.Brush.Background.Header}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="2,2,0,0"
                                Padding="6,4">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Zen.Style.TextBlock}">
                                        <Setter Property="FontWeight" Value="{StaticResource Zen.Font.Weight.Medium}" />
                                        <Setter Property="Foreground" Value="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,2,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource Zen.Style.GroupBox}" />

</ResourceDictionary>
