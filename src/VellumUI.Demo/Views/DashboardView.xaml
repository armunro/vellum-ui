<UserControl x:Class="VellumUI.Demo.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VellumUI.Controls;assembly=VellumUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
        <StackPanel>
            <!-- Header bar with Title, Status & Actions -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="System Overview &amp; Infrastructure" Style="{StaticResource Zen.Style.TextBlock.Heading}" />
                        <controls:ZenStatusIndicator Status="Online" IsPulsing="True" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <controls:ZenBadge Content="LIVE" Variant="Success" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Real-time performance metrics and high-density interface telemetry"
                               Style="{StaticResource Zen.Style.TextBlock.Secondary}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshDataCommand}" Style="{StaticResource Zen.Style.Button.Surface}" Margin="0,0,4,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Zen.Icon.Geometry.Refresh}" Width="11" Height="11" Fill="{StaticResource Zen.Brush.Foreground.VibrantCyan}" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Deploy" Style="{StaticResource Zen.Style.Button.Primary}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Zen.Icon.Geometry.Upload}" Width="11" Height="11" Fill="{StaticResource Zen.Brush.Primary.Foreground}" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Deploy Service" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Alert Callout Banner -->
            <controls:ZenCallout Title="Cluster Maintenance Window Scheduled"
                                 Severity="Info"
                                 IsDismissible="True"
                                 Margin="0,0,0,8"
                                 ActionButtonContent="View Schedule">
                <TextBlock Text="Automatic rolling updates for US-East cluster nodes will commence tonight at 02:00 UTC with zero downtime." />
            </controls:ZenCallout>

            <!-- 4 Quick Sleek Stat Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <!-- StatCard 1: Active Nodes -->
                <controls:ZenStatCard Title="ACTIVE NODES"
                                      Value="48"
                                      Unit="/ 50"
                                      TrendText="+4.2%"
                                      TrendDirection="Up"
                                      Description="vs yesterday"
                                      Icon="{StaticResource Zen.Icon.Geometry.Dashboard}"
                                      AccentBrush="{StaticResource Zen.Brush.Primary}"
                                      ShowTopAccent="True"
                                      Margin="0,0,4,0" />

                <!-- StatCard 2: CPU Load -->
                <controls:ZenStatCard Title="CPU UTILIZATION"
                                      Value="38.4"
                                      Unit="%"
                                      TrendText="-1.8%"
                                      TrendDirection="Down"
                                      Description="optimal range"
                                      Icon="{StaticResource Zen.Icon.Geometry.Controls}"
                                      AccentBrush="{StaticResource Zen.Brush.Secondary}"
                                      ShowTopAccent="True"
                                      Margin="4,0,4,0">
                    <ProgressBar Value="38.4" Maximum="100" Height="4" Foreground="{StaticResource Zen.Brush.Secondary}" />
                </controls:ZenStatCard>

                <!-- StatCard 3: Memory Allocation -->
                <controls:ZenStatCard Title="MEMORY ALLOCATION"
                                      Value="64.2"
                                      Unit="GB"
                                      TrendText="STABLE"
                                      TrendDirection="Neutral"
                                      Description="128 GB pool total"
                                      Icon="{StaticResource Zen.Icon.Geometry.Layers}"
                                      AccentBrush="{StaticResource Zen.Brush.Success}"
                                      ShowTopAccent="True"
                                      Margin="4,0,4,0">
                    <ProgressBar Value="64.2" Maximum="128" Height="10" Style="{StaticResource Zen.Style.ProgressBar.BarGraph}" Foreground="{StaticResource Zen.Brush.Success}" />
                </controls:ZenStatCard>

                <!-- StatCard 4: Network Throughput -->
                <controls:ZenStatCard Title="THROUGHPUT"
                                      Value="1,420"
                                      Unit="req/s"
                                      TrendText="+12.5%"
                                      TrendDirection="Up"
                                      Description="peak 2.8k req/s"
                                      Icon="{StaticResource Zen.Icon.Geometry.Sparkles}"
                                      AccentBrush="{StaticResource Zen.Brush.Warning}"
                                      ShowTopAccent="True"
                                      Margin="4,0,0,0" />
            </UniformGrid>

            <!-- Main Content Grid: Servers Table & Logs -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Production Servers DataGrid -->
                <controls:ZenCard Grid.Column="0" Header="MANAGED SERVERS" Subtitle="Active compute instances" Margin="0,0,4,0">
                    <controls:ZenCard.HeaderAction>
                        <controls:ZenSearchBox Placeholder="Filter servers..." Width="160" Height="24" />
                    </controls:ZenCard.HeaderAction>
                    <DataGrid ItemsSource="{Binding Servers}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ServerId}" Width="100" />
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="REGION" Binding="{Binding Region}" Width="90" />
                            <DataGridTemplateColumn Header="CPU" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0}%'}" Foreground="{StaticResource Zen.Brush.Foreground.VibrantCyan}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="MEMORY" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MemoryUsage, StringFormat='{}{0}%'}" Foreground="{StaticResource Zen.Brush.Foreground.VibrantPurple}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:ZenBadge Content="{Binding Status}" Variant="{Binding StatusVariant}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PING" Binding="{Binding Latency}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ZenCard>

                <!-- Right Column: System Logs & Tasks -->
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <!-- Project Tasks -->
                    <controls:ZenCard Header="ACTIVE TASKS" Subtitle="Milestone targets" Margin="0,0,0,8">
                        <ListBox ItemsSource="{Binding Tasks}" MaxHeight="130">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <controls:ZenBadge Grid.Column="2" Content="{Binding Priority}" Variant="{Binding PriorityVariant}" Margin="4,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </controls:ZenCard>

                    <!-- Realtime Telemetry Logs -->
                    <controls:ZenCard Header="TELEMETRY LOGS" Subtitle="Real-time events">
                        <ListBox ItemsSource="{Binding Logs}" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Timestamp}" Style="{StaticResource Zen.Style.TextBlock.Code}" Margin="0,0,6,0" />
                                            <controls:ZenBadge Content="{Binding Level}" Variant="{Binding LevelVariant}" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Zen.Style.TextBlock.Muted}" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource Zen.Brush.Foreground.Secondary}" FontSize="{StaticResource Zen.Font.Size.Caption}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </controls:ZenCard>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
