<UserControl x:Class="VellumUI.Demo.Views.InputsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VellumUI.Controls;assembly=VellumUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
        <StackPanel>
            <TextBlock Text="Form Inputs &amp; Controls" Style="{StaticResource Zen.Style.TextBlock.Heading}" />
            <TextBlock Text="Dense, high-productivity input controls styled with dark slate inset fields and vibrant cyan accents"
                       Style="{StaticResource Zen.Style.TextBlock.Secondary}" Margin="0,2,0,8" />

            <!-- Row 1: Text Inputs & ComboBoxes -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Text Boxes -->
                <controls:ZenCard Grid.Column="0" Header="TEXT &amp; FORM INPUTS" Subtitle="High-density data entry" Margin="0,0,4,0">
                    <StackPanel>
                        <!-- Standard Single-line Textbox -->
                        <TextBlock Text="Standard Input:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                        <!-- SearchBox with Clear Action -->
                        <TextBlock Text="Zen Search Input:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <controls:ZenSearchBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Placeholder="Search components or symbols..." Margin="0,0,0,6" />

                        <!-- Password Input -->
                        <TextBlock Text="Password Field:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <PasswordBox Password="SecretPassword123" Margin="0,0,0,6" />

                        <!-- Multiline TextBox -->
                        <TextBlock Text="Multiline Notes:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <TextBox Height="52" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="VellumUI is engineered for dense information layouts, developer tooling, and technical applications." />
                    </StackPanel>
                </controls:ZenCard>

                <!-- Dropdowns & Selection -->
                <controls:ZenCard Grid.Column="1" Header="SELECT &amp; DROPDOWNS" Subtitle="ComboBoxes and lists" Margin="4,0,0,0">
                    <StackPanel>
                        <!-- ComboBox 1 -->
                        <TextBlock Text="Deployment Target:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <ComboBox SelectedIndex="0" Margin="0,0,0,6">
                            <ComboBoxItem Content="Production (us-east-1)" />
                            <ComboBoxItem Content="Staging (us-west-2)" />
                            <ComboBoxItem Content="Development Local" />
                            <ComboBoxItem Content="Edge Cloud (eu-central-1)" />
                        </ComboBox>

                        <!-- ComboBox 2 (With Icons & Badges) -->
                        <TextBlock Text="Role &amp; Permissions:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <ComboBox SelectedIndex="1" Margin="0,0,0,6">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <controls:ZenBadge Content="ADMIN" Variant="Danger" Margin="0,0,6,0" />
                                    <TextBlock Text="System Administrator" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <controls:ZenBadge Content="DEV" Variant="Primary" Margin="0,0,6,0" />
                                    <TextBlock Text="Lead Engineer" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <controls:ZenBadge Content="READ" Variant="Muted" Margin="0,0,6,0" />
                                    <TextBlock Text="Viewer / Guest" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

                        <!-- Disabled State -->
                        <TextBlock Text="Disabled Dropdown:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <ComboBox IsEnabled="False" SelectedIndex="0" Margin="0,0,0,6">
                            <ComboBoxItem Content="Locked Selection" />
                        </ComboBox>
                    </StackPanel>
                </controls:ZenCard>
            </Grid>

            <!-- Row 2: Toggles, Checkboxes, RadioButtons & Sliders -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Toggles & Switches -->
                <controls:ZenCard Grid.Column="0" Header="TOGGLES &amp; CHECKBOXES" Subtitle="Binary &amp; multi-state selectors" Margin="0,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CheckBoxes -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Checkboxes" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,4" />
                            <CheckBox Content="Enable GPU Acceleration" IsChecked="True" Margin="0,0,0,4" />
                            <CheckBox Content="Auto-sync telemetry" IsChecked="False" Margin="0,0,0,4" />
                            <CheckBox Content="Indeterminate Tri-state" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,0,4" />
                            <CheckBox Content="Disabled Option" IsEnabled="False" IsChecked="True" Margin="0,0,0,4" />
                        </StackPanel>

                        <!-- RadioButtons & Switches -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Radio Group" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,4" />
                            <RadioButton Content="Standard Density" GroupName="Density" IsChecked="True" Margin="0,0,0,4" />
                            <RadioButton Content="Compact Mode" GroupName="Density" Margin="0,0,0,4" />

                            <TextBlock Text="Toggle Switches" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,4,0,4" />
                            <controls:ZenToggleSwitch Content="Live Monitoring" IsChecked="{Binding ToggleState1}" Margin="0,0,0,4" />
                            <controls:ZenToggleSwitch Content="Dark High Contrast" IsChecked="{Binding ToggleState2}" Margin="0,0,0,4" />
                        </StackPanel>
                    </Grid>
                </controls:ZenCard>

                <!-- Sliders & Progress Controls -->
                <controls:ZenCard Grid.Column="1" Header="SLIDERS &amp; VALUE ADJUSTERS" Subtitle="Smooth continuous controls" Margin="4,0,0,0">
                    <StackPanel>
                        <!-- Dynamic Slider -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Throughput Limit:" Style="{StaticResource Zen.Style.TextBlock.Caption}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SliderValue, StringFormat='{}{0:F0}%'}" Foreground="{StaticResource Zen.Brush.Foreground.VibrantCyan}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Value="{Binding SliderValue}" Minimum="0" Maximum="100" Margin="0,0,0,8" />

                        <!-- Secondary Colored Slider -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Vibrant Violet Track:" Style="{StaticResource Zen.Style.TextBlock.Caption}" HorizontalAlignment="Left" />
                            <TextBlock Text="85 MB/s" Foreground="{StaticResource Zen.Brush.Foreground.VibrantPurple}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Value="85" Minimum="0" Maximum="100" Foreground="{StaticResource Zen.Brush.Secondary}" Margin="0,0,0,8" />

                        <!-- Determinate and Indeterminate Progress -->
                        <TextBlock Text="Slim Progress Bar (Determinate):" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <ProgressBar Value="{Binding SliderValue}" Maximum="100" Margin="0,0,0,6" />

                        <TextBlock Text="Bar Graph Meter Style:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <ProgressBar Value="{Binding SliderValue}" Maximum="100" Style="{StaticResource Zen.Style.ProgressBar.BarGraph}" Margin="0,0,0,6" />

                        <TextBlock Text="Indeterminate Glowing Animation:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <ProgressBar IsIndeterminate="True" Height="6" />
                    </StackPanel>
                </controls:ZenCard>
            </Grid>

            <!-- Row 3: Date Selectors & Color Pickers -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Date Selectors -->
                <controls:ZenCard Grid.Column="0" Header="DATE &amp; TIME SELECTORS" Subtitle="Calendar and date pickers" Margin="0,0,4,0">
                    <StackPanel>
                        <!-- Standard DatePicker -->
                        <TextBlock Text="Standard DatePicker:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <DatePicker Margin="0,0,0,6" />

                        <!-- Zen DatePicker with Left Icon -->
                        <TextBlock Text="Zen Date Selector (With Icon):" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <controls:ZenDatePicker Icon="{StaticResource Zen.Icon.Geometry.Calendar}" Placeholder="Choose deploy date..." Margin="0,0,0,8" />

                        <!-- Standalone Inline Calendar -->
                        <TextBlock Text="Embedded Monthly Calendar:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,4" />
                        <Border Background="{StaticResource Zen.Brush.Background.Popup}"
                                BorderBrush="{StaticResource Zen.Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="4"
                                HorizontalAlignment="Left">
                            <Calendar />
                        </Border>
                    </StackPanel>
                </controls:ZenCard>

                <!-- Color Pickers -->
                <controls:ZenCard Grid.Column="1" Header="COLOR PICKERS &amp; PALETTES" Subtitle="RGBA, HSV and preset swatches" Margin="4,0,0,0">
                    <StackPanel>
                        <!-- Dropdown Color Picker -->
                        <TextBlock Text="Dropdown Color Selector (Cyan Accent):" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <controls:ZenColorPicker SelectedColor="#0EA5E9" Margin="0,0,0,8" />

                        <!-- Dropdown Color Picker 2 (Secondary Violet) -->
                        <TextBlock Text="Secondary Preset (Vibrant Violet):" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,2" />
                        <controls:ZenColorPicker SelectedColor="#8B5CF6" Margin="0,0,0,8" />

                        <!-- Palette-Only Swatch Grid -->
                        <TextBlock Text="Quick Palette Swatch Bar:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,4" />
                        <controls:ZenColorPicker DisplayMode="PaletteOnly" Margin="0,0,0,8" />

                        <!-- Inline Color Editor -->
                        <TextBlock Text="Inline RGBA / HSV Color Editor:" Style="{StaticResource Zen.Style.TextBlock.Caption}" Margin="0,0,0,4" />
                        <controls:ZenColorPicker DisplayMode="Inline" SelectedColor="#10B981" />
                    </StackPanel>
                </controls:ZenCard>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
