<controls:ZenWindow x:Class="VellumUI.Demo.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VellumUI.Controls;assembly=VellumUI"
                    xmlns:converters="clr-namespace:VellumUI.Converters;assembly=VellumUI"
                    xmlns:viewmodels="clr-namespace:VellumUI.Demo.ViewModels"
                    xmlns:views="clr-namespace:VellumUI.Demo.Views"
                    Title="VellumUI Studio - Demonstration App"
                    WindowIcon="{StaticResource Zen.Icon.Geometry.Layers}"
                    Width="1180" Height="740"
                    MinWidth="920" MinHeight="600"
                    WindowStartupLocation="CenterScreen">

    <controls:ZenWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
    </controls:ZenWindow.Resources>

    <controls:ZenWindow.DataContext>
        <viewmodels:MainViewModel />
    </controls:ZenWindow.DataContext>

    <!-- Custom TitleBar Content (Integrated Top Menu & Quick Actions) -->
    <controls:ZenWindow.TitleBarContent>
        <Grid Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top Menu Bar in TitleBar -->
            <Menu Grid.Column="0"
                  Background="Transparent"
                  VerticalAlignment="Center">
                <MenuItem Header="File">
                    <MenuItem Header="New Project..." InputGestureText="Ctrl+N" />
                    <MenuItem Header="Open Workspace..." InputGestureText="Ctrl+O" />
                    <Separator />
                    <MenuItem Header="Save Layout" InputGestureText="Ctrl+S" />
                    <MenuItem Header="Export Theme Configuration" />
                    <Separator />
                    <MenuItem Header="Exit" Command="{x:Static SystemCommands.CloseWindowCommand}" />
                </MenuItem>
                <MenuItem Header="Edit">
                    <MenuItem Header="Undo" InputGestureText="Ctrl+Z" />
                    <MenuItem Header="Redo" InputGestureText="Ctrl+Y" />
                    <Separator />
                    <MenuItem Header="Cut" InputGestureText="Ctrl+X" />
                    <MenuItem Header="Copy" InputGestureText="Ctrl+C" />
                    <MenuItem Header="Paste" InputGestureText="Ctrl+V" />
                </MenuItem>
                <MenuItem Header="View">
                    <MenuItem Header="Toggle Sidebar (Compact/Full)" Command="{Binding ToggleSidebarCommand}" InputGestureText="Ctrl+B" />
                    <MenuItem Header="Reset Window Layout" />
                    <Separator />
                    <MenuItem Header="High Density Mode" IsCheckable="True" IsChecked="True" />
                </MenuItem>
                <MenuItem Header="Tools">
                    <MenuItem Header="Email Client Sample" Command="{Binding NavigateCommand}" CommandParameter="EmailClient" />
                    <MenuItem Header="Color Palette Inspector" Command="{Binding NavigateCommand}" CommandParameter="DesignSystem" />
                    <MenuItem Header="Component Gallery" Command="{Binding NavigateCommand}" CommandParameter="Buttons" />
                    <MenuItem Header="System Telemetry" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="VellumUI Documentation" />
                    <MenuItem Header="About VellumUI Studio" />
                </MenuItem>
            </Menu>

            <!-- Draggable spacer area in middle of titlebar -->
            <Border Grid.Column="1" Background="Transparent" />

            <!-- Quick Global Search in TitleBar -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <controls:ZenSearchBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Placeholder="Search VellumUI..." Width="160" Height="22" Margin="0,0,8,0" />
                <controls:ZenBadge Content="PRO" Variant="Primary" VerticalAlignment="Center" Margin="0,0,8,0" />
                <controls:ZenStatusIndicator Status="Online" IsPulsing="True" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </controls:ZenWindow.TitleBarContent>

    <!-- Main Window Layout -->
    <Grid Background="{StaticResource Zen.Brush.Background.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <controls:ZenLeftNav Grid.Row="0" Grid.Column="0"
                             IsCompact="{Binding IsSidebarCompact}"
                             CompactWidth="48" ExpandedWidth="210">
            <!-- Sidebar Header -->
            <controls:ZenLeftNav.Header>
                <Border Background="{StaticResource Zen.Brush.Background.Header}"
                        BorderBrush="{StaticResource Zen.Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid>
                        <!-- Brand Title (visible only when expanded) -->
                        <StackPanel HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Path Data="{StaticResource Zen.Icon.Geometry.Layers}" Width="15" Height="15" Fill="{StaticResource Zen.Brush.Foreground.VibrantCyan}" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="ZEN UI" FontWeight="Bold" Foreground="{StaticResource Zen.Brush.Foreground.Primary}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Collapse Toggle Button (centered when compact, right-aligned when expanded) -->
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Width="22" Height="22"
                                ToolTip="Toggle Sidebar (Ctrl+B)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Zen.Style.Button.Icon}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource Zen.Icon.Geometry.Menu}" Width="12" Height="12" Fill="{StaticResource Zen.Brush.Foreground.Secondary}" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </controls:ZenLeftNav.Header>

            <!-- Nav Items -->
            <controls:ZenNavSection Header="OVERVIEW" Margin="0,6,0,4" />
            <controls:ZenNavItem Header="Dashboard"
                                 Icon="{StaticResource Zen.Icon.Geometry.Dashboard}"
                                 IsSelected="True"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Dashboard"
                                 Badge="Live" BadgeVariant="Success" />

            <controls:ZenNavSection Header="CONTROLS &amp; INPUTS" />
            <controls:ZenNavItem Header="Buttons &amp; Actions"
                                 Icon="{StaticResource Zen.Icon.Geometry.Sparkles}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Buttons"
                                 Badge="8" BadgeVariant="Primary" />
            <controls:ZenNavItem Header="Form Inputs"
                                 Icon="{StaticResource Zen.Icon.Geometry.Controls}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Inputs" />

            <controls:ZenNavSection Header="DATA &amp; LAYOUT" />
            <controls:ZenNavItem Header="Data Tables &amp; Trees"
                                 Icon="{StaticResource Zen.Icon.Geometry.Table}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="DataTables" />
            <controls:ZenNavItem Header="Navigation &amp; Menus"
                                 Icon="{StaticResource Zen.Icon.Geometry.Navigation}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="NavigationDemo"
                                 Badge="Top+Left" BadgeVariant="Secondary" />
            <controls:ZenNavItem Header="Cards &amp; Containers"
                                 Icon="{StaticResource Zen.Icon.Geometry.Folder}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="CardsContainers" />

            <controls:ZenNavSection Header="SAMPLE APPLICATIONS" />
            <controls:ZenNavItem Header="Email Client"
                                 Icon="{StaticResource Zen.Icon.Geometry.Mail}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="EmailClient"
                                 Badge="New" BadgeVariant="Primary" />

            <controls:ZenNavSection Header="DESIGN SYSTEM" />
            <controls:ZenNavItem Header="Colors &amp; Density"
                                 Icon="{StaticResource Zen.Icon.Geometry.Palette}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="DesignSystem"
                                 Badge="Dark" BadgeVariant="Primary" />

            <!-- Sidebar Footer -->
            <controls:ZenLeftNav.Footer>
                <Border Background="{StaticResource Zen.Brush.Background.Header}"
                        BorderBrush="{StaticResource Zen.Brush.Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ZenStatusIndicator Grid.Column="0" Status="Online" IsPulsing="True" VerticalAlignment="Center" ToolTip="Online - Andrew Munro">
                            <controls:ZenStatusIndicator.Style>
                                <Style TargetType="{x:Type controls:ZenStatusIndicator}">
                                    <Setter Property="Margin" Value="2,0,6,0" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                                            <Setter Property="Margin" Value="10,2" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:ZenStatusIndicator.Style>
                        </controls:ZenStatusIndicator>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisConverter}}">
                            <TextBlock Text="Andrew Munro" FontSize="{StaticResource Zen.Font.Size.Caption}" FontWeight="Medium" Foreground="{StaticResource Zen.Brush.Foreground.Primary}" />
                            <TextBlock Text="Lead Developer" FontSize="{StaticResource Zen.Font.Size.Micro}" Foreground="{StaticResource Zen.Brush.Foreground.Muted}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Zen.Style.Button.Icon}" Width="20" Height="20" ToolTip="Settings"
                                Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Path Data="{StaticResource Zen.Icon.Geometry.Settings}" Width="11" Height="11" Fill="{StaticResource Zen.Brush.Foreground.Muted}" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </controls:ZenLeftNav.Footer>
        </controls:ZenLeftNav>

        <!-- Main Body Area with Views Switcher -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource Zen.Brush.Background.App}" Margin="0">
            <Grid>
                <!-- Dashboard View -->
                <views:DashboardView>
                    <views:DashboardView.Style>
                        <Style TargetType="{x:Type views:DashboardView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Dashboard">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:DashboardView.Style>
                </views:DashboardView>

                <!-- Buttons View -->
                <views:ButtonsView>
                    <views:ButtonsView.Style>
                        <Style TargetType="{x:Type views:ButtonsView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Buttons">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ButtonsView.Style>
                </views:ButtonsView>

                <!-- Form Inputs View -->
                <views:InputsView>
                    <views:InputsView.Style>
                        <Style TargetType="{x:Type views:InputsView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Inputs">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:InputsView.Style>
                </views:InputsView>

                <!-- Data Tables View -->
                <views:DataTablesView>
                    <views:DataTablesView.Style>
                        <Style TargetType="{x:Type views:DataTablesView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="DataTables">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:DataTablesView.Style>
                </views:DataTablesView>

                <!-- Navigation Demo View -->
                <views:NavigationDemoView>
                    <views:NavigationDemoView.Style>
                        <Style TargetType="{x:Type views:NavigationDemoView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="NavigationDemo">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:NavigationDemoView.Style>
                </views:NavigationDemoView>

                <!-- Cards & Containers View -->
                <views:CardsContainersView>
                    <views:CardsContainersView.Style>
                        <Style TargetType="{x:Type views:CardsContainersView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="CardsContainers">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:CardsContainersView.Style>
                </views:CardsContainersView>

                <!-- Design System View -->
                <views:DesignSystemView>
                    <views:DesignSystemView.Style>
                        <Style TargetType="{x:Type views:DesignSystemView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="DesignSystem">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:DesignSystemView.Style>
                </views:DesignSystemView>

                <!-- Email Client View -->
                <views:EmailClientView>
                    <views:EmailClientView.Style>
                        <Style TargetType="{x:Type views:EmailClientView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="EmailClient">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:EmailClientView.Style>
                </views:EmailClientView>
            </Grid>
        </Border>

        <!-- Bottom High-Density Status Bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource Zen.Brush.Background.Canvas}"
                BorderBrush="{StaticResource Zen.Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Height="24"
                Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:ZenStatusIndicator Status="Online" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Zen.Style.TextBlock.Caption}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Active Section -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="View: " Style="{StaticResource Zen.Style.TextBlock.Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedSection}" Foreground="{StaticResource Zen.Brush.Foreground.VibrantCyan}" FontSize="{StaticResource Zen.Font.Size.Caption}" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Density Spec Marker -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Density: " Style="{StaticResource Zen.Style.TextBlock.Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="High Density (Minimal 2px Radius / Minimal Margins)" Foreground="{StaticResource Zen.Brush.Foreground.VibrantGreen}" FontSize="{StaticResource Zen.Font.Size.Caption}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Version / Target -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:ZenBadge Content=".NET 8.0 WPF" Variant="Muted" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:ZenWindow>
